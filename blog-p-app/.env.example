# Copie para .env e preencha com as credenciais do seu app Web no Firebase
# (Console do Firebase → Configurações do projeto → Seus apps).
# Sem essas variáveis o formulário de contato abre o e-mail do visitante como alternativa.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
